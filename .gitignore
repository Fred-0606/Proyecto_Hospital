# Python: entornos, cachés y herramientas
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Positron y editores
.positron/
.vscode/
.idea/

# Variables de entorno, credenciales y secretos
.env
.env.*
!.env.example

# Datos hospitalarios y artefactos derivados
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Evidencias locales derivadas de la etapa 01
outputs/figures/01_*
outputs/metrics/01_*
outputs/tables/01_*

# Protección explícita del archivo fuente sensible
database_modificado.xlsx
**/database_modificado.xlsx

# Modelos serializados
*.pkl
*.pickle
*.joblib
*.onnx
outputs/models/*
!outputs/models/.gitkeep

# Quarto
_site/
.quarto/
*_files/

# Archivos temporales
*.tmp
*.temp
*.bak
*.swp
*.swo
~$*

# Windows y otros sistemas operativos
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

/.quarto/
**/*.quarto_ipynb
_freeze/
